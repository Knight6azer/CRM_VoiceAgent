# ==============================================================================
# Riverwood AI CRM Voice Agent - Environment Configuration Template
# ==============================================================================

# --- Required for AI Conversation & Transcription ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# --- Optional for High-Fidelity Voice Synthesis (ElevenLabs) ---
# If omitted or left as placeholder, system falls back to OpenAI TTS or OS TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=pNInz6ovhh85mx4SdID9
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Required for Twilio Voice Webhooks & Outbound Calls ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_BASE_URL=https://your-public-twilio-webhook-domain.com

# --- Security & Verification ---
# Set to 'true' in production to enforce Twilio HMAC-SHA1 signature validation.
# Set to 'false' during local development or unit testing.
TWILIO_VALIDATE_SIGNATURE=false

# --- Privacy & Compliance ---
# Mask phone numbers in transcripts and callback records (e.g. +1555***4567)
LOG_MASK_PHONE=true

# --- Optional / Legacy Integration Placeholders (Not required for core voice agent) ---
APOLLO_API_KEY=your_apollo_api_key
VAPI_API_KEY=your_vapi_api_key
